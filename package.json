    "next": "15.5.29",
    "papaparse": "^5.7.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.35.5",
    "stream-json": "^3.9.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
