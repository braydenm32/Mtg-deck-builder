/**
 * Writes src/lib/deck/theme-list.ts: every theme EDHREC lists (its /tags page, most decks first),
 * every creature type, and the rules words (keywords, ability words, subtypes) that themes can be
 * matched by. The app reads this snapshot and never fetches the lists while you use it.
 *
 * Run it now and then to pick up new themes and types: `npx tsx scripts/make-theme-list.mts`
 * (in the cloud sandbox, with NODE_USE_ENV_PROXY=1).
 */
import { writeFileSync } from "node:fs";
import { USER_AGENT } from "../src/lib/scryfall/client";

const headers = { "User-Agent": USER_AGENT, Accept: "application/json" };
const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

async function json(url: string): Promise<unknown> {
  const res = await fetch(url, { headers });
  if (!res.ok) throw new Error(`${url}: ${res.status}`);
  return res.json();
}

type TagView = { name: string; url: string; num_decks?: number };
const tags = (await json("https://json.edhrec.com/pages/tags.json")) as { container: { json_dict: { cardlists: { cardviews: TagView[] }[] } } };
const themes: [string, string, number][] = [];
for (const v of tags.container.json_dict.cardlists.flatMap((l) => l.cardviews)) {
  const slug = v.url.replace(/^\/tags\//, "");
  if (!/^[a-z0-9-]+$/.test(slug) || slug === "custom-cards" || themes.some((t) => t[0] === slug)) continue;
  themes.push([slug, v.name, v.num_decks ?? 0]);
}

async function catalog(name: string): Promise<string[]> {
  await sleep(150);
  return ((await json(`https://api.scryfall.com/catalog/${name}`)) as { data: string[] }).data;
}
const creatureTypes = await catalog("creature-types");
const words = new Set<string>();
for (const c of ["keyword-abilities", "keyword-actions", "ability-words", "artifact-types", "enchantment-types", "land-types", "spell-types", "battle-types"]) {
  for (const w of await catalog(c)) words.add(w);
}

const list = (xs: string[]) => xs.map((x) => JSON.stringify(x)).join(", ");
const out = `/*
 * Generated by scripts/make-theme-list.mts on ${new Date().toISOString().slice(0, 10)}. Don't edit by hand; run the script again.
 * Sources: EDHREC's theme list (json.edhrec.com/pages/tags.json) and Scryfall's catalogs.
 */

/** Every EDHREC theme as [slug, label, decks], most decks first. Typal themes (Dragons, Slivers…) are in here too. */
export const EDHREC_THEMES: [slug: string, label: string, decks: number][] = [
${themes.map((t) => `  ${JSON.stringify(t)},`).join("\n")}
];

/** Every creature type, as Scryfall spells them. */
export const CREATURE_TYPES: string[] = [${list(creatureTypes)}];

/** Keywords, keyword actions, ability words and non-creature subtypes: a theme named after one is matched by it. */
export const RULES_WORDS: string[] = [${list([...words].sort())}];
`;
writeFileSync(new URL("../src/lib/deck/theme-list.ts", import.meta.url), out);
console.log(`${themes.length} themes, ${creatureTypes.length} creature types, ${words.size} rules words`);
